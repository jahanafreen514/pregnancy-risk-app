# Required application configuration
MONGODB_URL=mongodb://localhost:27017/glowcare
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Public deployment addresses
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
WEBSOCKET_URL=wss://api.example.com/api

# Email / OTP / reminders
# Production on Render free tier: use Resend over HTTPS (not SMTP).
# Create these values in the Render dashboard; never commit the actual key.
RESEND_API_KEY=
EMAIL_FROM=GlowCare <no-reply@example.com>

# SMTP is suitable for local development or a host that permits SMTP ports.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Optional WebRTC configuration. The default consultation flow uses WhatsApp.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional external services
OCR_API_KEY=
STORAGE_CONFIG=
